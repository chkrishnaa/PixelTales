# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pixeltales?retryWrites=true&w=majority

# ── Frontend URL (for CORS) ───────────────────────────────
CLIENT_URL=http://localhost:5173

# ── JWT (for auth — add later) ────────────────────────────
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES_IN=7d

# ── Email (Nodemailer — add later) ────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=PixelTales <no-reply@pixeltales.com>
